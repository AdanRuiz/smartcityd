{
  "name": "relay-strfry",
  "version": "0.1.0",
  "private": true,
  "description": "Relay Nostr estándar (strfry) con la política de escritura de SmartCity, para operar fuera de Cloudflare (ARCH-1)",
  "type": "module",
  "scripts": {
    "build": "esbuild src/policy.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/policy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartcity/schemas": "workspace:*",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2"
  }
}
