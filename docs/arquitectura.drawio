        <mxCell id="title" value="&lt;b&gt;Smart city descentralizada · Arquitectura v1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ver docs/spec/01-arquitectura.md · Ningún componente es obligatorio&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
