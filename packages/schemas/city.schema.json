{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityContent",
  "description": "Kind 31480 · city",
  "type": "object",
  "required": ["v", "name", "bbox", "tz", "relays", "roots"],
  "properties": {
    "v": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "bbox": {
      "description": "[minLat, minLon, maxLat, maxLon]",
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ]
    },
    "tz": { "description": "IANA time zone", "type": "string", "minLength": 1 },
    "relays": {
      "type": "array",
      "items": { "type": "string", "pattern": "^wss?://" }
    },
    "roots": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/hex64" }
    },
    "tiles": {
      "type": "object",
      "required": ["x"],
      "properties": {
        "x": { "$ref": "#/$defs/hex64" },
        "cid": { "type": "string" },
        "magnet": { "type": "string", "pattern": "^magnet:\\?" },
        "urls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "about": { "type": "string" }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
