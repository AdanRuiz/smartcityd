{
  "name": "@smartcity/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "SDK del protocolo SmartCity: firma, validación, pool de relays, publicación y consulta (docs/spec/05)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify-worker": {
      "types": "./dist/verify-worker.d.ts",
      "default": "./dist/verify-worker.js"
    },
    "./pow-worker": {
      "types": "./dist/pow-worker.d.ts",
      "default": "./dist/pow-worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@smartcity/schemas": "workspace:*",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cli-table3": "0.6.5",
    "fake-indexeddb": "^6.2.5"
  }
}
