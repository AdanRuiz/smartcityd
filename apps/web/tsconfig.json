{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // vite.config.ts and build/ import with the extension, as Vite's native config loader requires.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "types": ["vite/client"]
  },
  "include": ["src", "build", "test", "vite.config.ts"]
}
